{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/convert/pptx-to-pdf.ts": {
      "maxDuration": 60,
      "memory": 2048,
      "includeFiles": "node_modules/@matbee/libreoffice-converter/wasm/**"
    },
    "api/gemini/*.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/health.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
